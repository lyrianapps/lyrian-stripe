generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum Plan {
  free_trial
  basic
  pro
  paygo
  volume
}

enum BillingInterval {
  month
}

enum BillingType {
  flat_rate
  metered
  volume
}

enum SubscriptionEventType {
  created
  upgraded
  downgraded
  canceled
  renewed
  reactivated
  payment_failed
  payment_succeeded
}

model App {
  id     String  @id
  name   String
  apiKey String? @unique

  // Per-app email config — each SaaS product owns its own Resend key + sending domain.
  // Falls back to global RESEND_API_KEY / FROM_EMAIL env vars when not set.
  resendApiKey String? // re_live_xxxx
  fromEmail    String? // e.g. "billing@yourapp.com"

  // Per-app Stripe credentials — each SaaS product owns its own Stripe account keys.
  // Falls back to global STRIPE_SECRET_KEY / STRIPE_PK_KEY / STRIPE_WEBHOOK_SECRET env vars when not set.
  stripeSecretKey      String? // sk_live_... or sk_test_...
  stripePublishableKey String? // pk_live_... or pk_test_...
  stripeWebhookSecret  String? // whsec_...

  // Cached Stripe Customer Portal configuration ID.
  // This config disables the "cancel subscription" button in the portal so
  // users must cancel through our own delete-account flow instead of bypassing it.
  // Created lazily on first portal visit, then reused.
  stripePortalConfigId String? // bpc_...

  // Set to true once the app's Stripe credentials and plans have been
  // successfully verified via GET /api/apps/[appId]/verify.
  // Used by integrating apps to gate user access until setup is complete.
  isConfigured Boolean @default(false)

  // Declares whether this app uses flat-rate subscriptions or metered (pay-as-you-go) billing.
  // All plans configured for this app must have a matching billingType.
  // null = not yet declared (legacy apps or not yet configured).
  billingMode BillingType?

  customers BillingCustomer[]
  plans     AppPlan[]
}

// Pricing plans configured per SaaS app
model AppPlan {
  id    String @id @default(cuid())
  appId String

  // Plan identifier (e.g., "free", "basic", "pro")
  planKey String

  // Display info
  name        String // "Basic Plan", "Pro Plan"
  description String? // "For individuals and small teams"
  price       Int // Price in cents (e.g., 1000 = $10.00)
  currency    String          @default("usd")
  interval    BillingInterval @default(month)

  // Stripe IDs (owned by the SaaS app's Stripe account)
  stripeProductId String
  stripePriceId   String

  // Ordering for display
  sortOrder Int @default(0)

  // Soft delete / disable
  isActive Boolean @default(true)

  // Billing type — drives how customers are charged
  billingType          BillingType @default(flat_rate)
  // Cents per unit (required for metered and volume plans)
  unitAmount           Int?
  // Hard monthly unit cap enforced at the API level (e.g. 500 for a free tier)
  freeUnitsPerMonth    Int?
  // Minimum monthly units required (volume commitment plans)
  minMonthlyUnits      Int?
  // Stripe Billing Meter event name for metered/volume plans (e.g. "verifications")
  // Must match a meter created in the app's Stripe account
  stripeMeterEventName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, planKey])
  @@index([appId])
}

model BillingCustomer {
  id             String @id @default(cuid())
  appId          String
  externalUserId String

  app App @relation(fields: [appId], references: [id])

  stripeCustomerId String   @unique
  email            String?
  createdAt        DateTime @default(now())

  // Set to true by the payment_method.attached webhook when a duplicate card is
  // detected and silently removed. The subscription page reads-and-clears this
  // flag to show the user a consistent "card already on file" banner.
  duplicateCardDetected Boolean @default(false)

  subscriptions   Subscription[]
  billingSessions BillingSession[]
  paymentEvents   PaymentEvent[]
  monthlyUsages   MonthlyUsage[]

  @@unique([appId, externalUserId], name: "appId_externalUserId")
}

model BillingSession {
  id                String @id @default(cuid())
  billingCustomerId String
  appId             String
  externalUserId    String

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@index([billingCustomerId])
  @@index([appId, externalUserId])
}

model PlanConfig {
  id   String @id @default(cuid())
  plan Plan

  stripeProductId String
  stripePriceId   String @unique

  createdAt DateTime @default(now())

  @@unique([plan])
}

model Subscription {
  id                String @id @default(cuid())
  billingCustomerId String

  stripeSubscriptionId     String  @unique
  stripePriceId            String
  stripeProductId          String
  // Stripe subscription item ID (si_...) — required for reporting metered usage records
  stripeSubscriptionItemId String?

  plan   Plan
  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean

  accessEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingCustomer BillingCustomer     @relation(fields: [billingCustomerId], references: [id])
  events          SubscriptionEvent[]

  @@index([billingCustomerId])
}

model SubscriptionEvent {
  id             String @id @default(cuid())
  subscriptionId String

  type     SubscriptionEventType
  fromPlan Plan?
  toPlan   Plan?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model PaymentEvent {
  id                String @id @default(cuid())
  billingCustomerId String

  stripeInvoiceId      String
  stripeSubscriptionId String?

  type     PaymentEventType
  amount   Int // Amount in cents
  currency String           @default("usd")

  // For failed payments
  failureCode    String?
  failureMessage String?
  attemptCount   Int       @default(1)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@index([billingCustomerId])
  @@index([stripeInvoiceId])
}

enum PaymentEventType {
  payment_succeeded
  payment_failed
  payment_action_required
}

// Tracks unit usage per customer per calendar month.
// Used to enforce free-tier caps and to back-fill Stripe metered usage records.
// "unit" is intentionally generic — the SaaS app decides what counts as one unit
// (a verification, an API call, a processed minute, etc.).
model MonthlyUsage {
  id                String   @id @default(cuid())
  billingCustomerId String
  appId             String
  // Calendar-month bucket in "YYYY-MM" format (e.g. "2026-05")
  yearMonth         String
  unitCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@unique([billingCustomerId, yearMonth])
  @@index([appId, yearMonth])
}

// Deduplication table for POST /api/usage/report idempotency keys.
// Prevents double-billing when a caller retries a request (e.g. after a network timeout).
// Records expire after 24 hours — old rows can be pruned by a cron job.
model UsageIdempotencyKey {
  id                String   @id @default(cuid())
  // Caller-supplied idempotency key (e.g. "projectId:identifier:minuteBucket")
  key               String   @unique
  billingCustomerId String
  appId             String
  // Serialised UsageResult returned on first processing — replayed on duplicates
  resultJson        String
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model StripeEvent {
  id   String @id
  type String

  payload Json

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
}
