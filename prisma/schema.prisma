generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum Plan {
  free_trial
  basic
  pro
}

enum BillingInterval {
  month
}

enum SubscriptionEventType {
  created
  upgraded
  downgraded
  canceled
  renewed
  reactivated
  payment_failed
  payment_succeeded
}

model App {
  id     String  @id
  name   String
  apiKey String? @unique

  customers BillingCustomer[]
}

model BillingCustomer {
  id             String @id @default(cuid())
  appId          String
  externalUserId String

  app App @relation(fields: [appId], references: [id])

  stripeCustomerId String   @unique
  email            String?
  createdAt        DateTime @default(now())

  subscriptions   Subscription[]
  billingSessions BillingSession[]
  paymentEvents   PaymentEvent[]

  @@unique([appId, externalUserId], name: "appId_externalUserId")
}

model BillingSession {
  id                String @id @default(cuid())
  billingCustomerId String
  appId             String
  externalUserId    String

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@index([billingCustomerId])
  @@index([appId, externalUserId])
}

model PlanConfig {
  id   String @id @default(cuid())
  plan Plan

  stripeProductId String
  stripePriceId   String @unique

  createdAt DateTime @default(now())

  @@unique([plan])
}

model Subscription {
  id                String @id @default(cuid())
  billingCustomerId String

  stripeSubscriptionId String @unique
  stripePriceId        String
  stripeProductId      String

  plan   Plan
  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean

  accessEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingCustomer BillingCustomer     @relation(fields: [billingCustomerId], references: [id])
  events          SubscriptionEvent[]

  @@index([billingCustomerId])
}

model SubscriptionEvent {
  id             String @id @default(cuid())
  subscriptionId String

  type     SubscriptionEventType
  fromPlan Plan?
  toPlan   Plan?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model PaymentEvent {
  id                String @id @default(cuid())
  billingCustomerId String

  stripeInvoiceId      String
  stripeSubscriptionId String?

  type     PaymentEventType
  amount   Int // Amount in cents
  currency String           @default("usd")

  // For failed payments
  failureCode    String?
  failureMessage String?
  attemptCount   Int       @default(1)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@index([billingCustomerId])
  @@index([stripeInvoiceId])
}

enum PaymentEventType {
  payment_succeeded
  payment_failed
  payment_action_required
}

model StripeEvent {
  /**
   * Stripe event ID (evt_*)
   * Used for idempotency
   */
  id   String @id
  type String

  payload Json

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
}
