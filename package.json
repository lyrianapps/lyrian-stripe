    "lucide-react": "^0.563.0",
    "moment": "^2.30.1",
    "next": "16.1.4",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "rate-limiter-flexible": "^9.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "stripe": "^20.2.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
